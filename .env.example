# =====================================================================
#  BuyBooks.com — environment variables
#  1. Copy this file to ".env" (local dev) — never commit .env
#  2. Add the same keys in Vercel → Project → Settings → Environment Variables
# =====================================================================

# ---------- Frontend (exposed to the browser — public values only!) ----------
# Supabase → Project Settings → API
# (Project URL looks like https://abcdefgh.supabase.co)
VITE_SUPABASE_URL=
# anon / Publishable key
VITE_SUPABASE_ANON_KEY=

# ---------- Server only (used by /api functions and `npm run seed` — keep secret!) ----------
# Your live site URL (used for Stripe redirect links). Local with `vercel dev`: http://localhost:3000
SITE_URL=https://buybooks.com

# Supabase → Project Settings → API (service_role key — NEVER expose to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API keys → Secret key (starts with sk_test_ in test mode, sk_live_ in live mode)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → your endpoint → Signing secret (starts with whsec_)
STRIPE_WEBHOOK_SECRET=

# Countries you ship paperbacks to (2-letter codes, comma-separated)
SHIPPING_COUNTRIES=US,CA,GB,IE,GH,NG,KE,ZA,AU,DE,FR,NL
